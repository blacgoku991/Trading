# Copier ce fichier en .env sur la machine Windows et le remplir.
# .env n'est jamais commité. Ne colle jamais ces valeurs dans un chat.
#
# Guillemets :
# - mot de passe contenant un espace, un # ou un guillemet : l'entourer de guillemets
#   SIMPLES, ex. MT5_PASSWORD='mon #mot de passe' (sinon il est tronqué au « #») ;
# - chemin Windows : SANS guillemets ou entre guillemets simples, jamais doubles
#   (entre guillemets doubles, \t et \n deviennent des caractères invisibles).

# Compte MT5 Axi
MT5_LOGIN=
MT5_PASSWORD=
# Nom EXACT du serveur, tel qu'affiché dans MT5 (Fichier > Connexion à un compte de trading)
MT5_SERVER=
# Chemin complet de terminal64.exe du terminal Axi (recommandé), par exemple :
# MT5_PATH=C:\Program Files\<dossier du terminal Axi>\terminal64.exe
# Vide : le module cherche le terminal lui-même (déconseillé si plusieurs terminaux).
MT5_PATH=

# Telegram (Phase 5)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Garde-fou compte réel : laisser false. Sur un compte réel, le bot refuse de
# trader sauf si LIVE_TRADING=true ET l'argument --i-understand-real-money.
LIVE_TRADING=false
